{
  "name": "@local/creator-studio",
  "version": "0.1.0",
  "private": true,
  "description": "创作台：写文章、做小红书卡片和短视频，国内热榜和国内搜索找选题，一键整理发到公众号、小红书、知乎、今日头条、微博。AI 用 DSH 里配好的模型。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "host/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "workbench/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "~0.2.2-rc.1"
  }
}
