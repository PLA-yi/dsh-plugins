.workbench/
.workbench.json

.DS_Store
*.log
.env
.env.*

# 视频板块的依赖：链出来的 ffmpeg / ffprobe / cmake，和装 cmake 用的 Python 环境
video/runtime/bin/
video/runtime/py/
